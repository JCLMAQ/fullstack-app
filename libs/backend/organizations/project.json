{
  "name": "backend-organizations",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/organizations/src",
  "projectType": "library",
  "tags": ["backend", "domain:organizations"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/organizations",
        "tsConfig": "libs/backend/organizations/tsconfig.lib.json",
        "packageJson": "libs/backend/organizations/package.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/backend/organizations/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/backend/organizations/jest.config.ts"
      }
    }
  }
}