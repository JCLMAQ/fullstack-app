<p>todo-list works!</p>

<div>
  <span>Direct database access: </span>
  <ul>
    <!-- @let error = #store.error() ; -->
    @if (errorLoading()) {
      <p>{{ errorLoading() }}</p>
    }

    @if (todos.isLoading()) {
      <p>Loading todos...</p>
    }

    @for (todo of todos.value(); track todo.id) {
      <li>{{todo.title }} - id: {{ todo.id }}</li>
    }  @empty {
      <p>No todos!</p>
    }
  </ul>
</div>
<br>
<div>
  <span>Store access: </span>
  <ul>
    @for (item of items.value(); track item.id) {
      <li>{{item.title }} {{ item.id }}</li>
    }  @empty {
      <p>No todos!</p>
    }
    @if (items.value()?.length === 0 && !loading()) {
      <p class="text-lg">Sorry, no items found.</p>
    }
  </ul>
</div>
