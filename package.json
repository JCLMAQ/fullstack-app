{
  "name": "@fullstack-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "commonjs",
  "prisma": {
    "seed": " npx tsx zmodel/seeddb/seed.ts"
  },
  "scripts": {
    "pnpm-instal": "pnpm install --no-frozen-lockfile",
    "pnpm-auto-update": "pnpm update",
    "pnpm approve-builds scripts": "pnpm approve-builds",
    "nxupdate": "nx migrate latest",
    "nxmigrate": "nx migrate --run-migrations",
    "db:docker:up": "docker compose -f './db/docker-compose.yml' --env-file ./.env up -d --build",
    "db:docker:down": "docker compose -f './db/docker-compose.yml' --env-file ./.env down",
    "start:zenstack-prisma": "pnpm run zenstack:generate && pnpm run prisma:generate && pnpm run prisma-migrate",
    "start:backend:dev": "pnpm run configproxy && nx serve nestjs --watch",
    "start:frontend:dev": "pnpm run configangular -- --environment=dev && nx serve jcm-app --proxy-config ./proxy.config.json --host 127.0.0.1 --port 4100",
    "start:frontend:script": "dotenv -e ./.env npx tsx ./scripts/run-env.ts",
    "prisma:studio": "dotenv -e ./.env -- pnpm exec prisma studio --schema=./zmodel/prisma/schema.prisma",
    "seed-param": "dotenv -e ./.env npx tsx zmodel/seeddb/seed-param.ts",
    "seed-faker": "dotenv -e ./.env npx tsx zmodel/seeddb/seedfaker.ts",
    "seed-org": "dotenv -e ./.env npx tsx zmodel/seeddb/seedOrg.ts",
    "seed-old": "pnpm exec prisma db seed",
    "seed": "dotenv -e ./.env npx tsx zmodel/seeddb/seed.ts",
    "db-reset": "dotenv -e ./.env npx tsx zmodel/seeddb/resetdb.ts",
    "nx": "pnpm nx",
    "preinstall": "typesync || :",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "zenstack:generate": "zenstack generate --schema zmodel/schema.zmodel --output zmodel/prisma_new",
    "zenStack:repl": "pnpm exec zenstack repl",
    "zenstack:info": "zenstack info",
    "zenstack:init": "pnpm exec zenstack init -p pnpm",
    "start:prisma": "pnpm run prisma:generate && pnpm run prisma-migrate",
    "generate-metadata-swagger": "ts-node ./apps/backend/src/generate-metadata.ts",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:generate:watch": "pnpm exec prisma generate --watch",
    "prisma-migrate-old": "pnpm exec prisma migrate dev",
    "prisma-migrate": "node prisma-migrate-expand.js",
    "circular-dependency": "pnpm madge --circular apps/backend/src/main.ts",
    "configangular": "dotenv -e ../.env npx tsx ./scripts/setenv.ts",
    "configproxy": "dotenv -e ../.env ts-node ./scripts/setproxyconfig.js",
    "ng": "pnpm nx",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test"
  },
  "private": true,
