{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bd/prisma": ["libs/prisma/src/index.ts"],
      "@be/auths": ["libs/backend/auths/src/index.ts"],
      "@be/changestracking": [
        "libs/backend/utilities/changestracking/src/index.ts"
      ],
      "@be/common": ["libs/backend/common/src/index.ts"],
      "@be/db-config": ["libs/backend/utilities/db-config/src/index.ts"],
      "@be/files": ["libs/backend/utilities/files/src/index.ts"],
      "@be/iam": ["libs/backend/iam/src/index.ts"],
      "@be/jwtconfig": ["libs/backend/common/src/lib/config/jwt.config"],
      "@be/mails": ["libs/backend/utilities/mails/src/index.ts"],
      "@be/posts": ["libs/backend/posts/src/index.ts"],
      "@be/tasks": ["libs/backend/tasks/src/index.ts"],
      "@be/time-util": ["libs/backend/utilities/time-util/src/index.ts"],
      "@be/todos": ["libs/backend/todos/src/index.ts"],
      "@be/users": ["libs/backend/users/src/index.ts"],
      "@fe/buttons-detail": ["libs/frontend/ui/buttons-detail/src/index.ts"],
      "@fe/confirmation-dialog": [
        "libs/frontend/ui/confirmation-dialog/src/index.ts"
      ],

      "@fe/dashboard": ["libs/frontend/dashboard/src/index.ts"],
      "@fe/environment": ["apps/frontend/jcm-app/index.ts"],
      "@fe/environnement": ["apps/frontend/jcm-app/environments/index.ts"],
      "@fe/error-field": ["libs/frontend/ui/error-field/src/index.ts"],
      "@fe/geolocation": ["libs/frontend/ui/geolocation/src/index.ts"],
      "@fe/home": ["libs/frontend/ui/pages/src/index.ts"],
      "@fe/image-uploader": ["libs/frontend/ui/image-uploader/src/index.ts"],
      "@fe/language-selector": ["libs/frontend/ui/i18n/src/index.ts"],
      "@fe/loading-indicator": [
        "libs/frontend/ui/loading-indicator/src/index.ts"
      ],
      "@fe/material": ["libs/frontend/material/src/index.ts"],
      "@fe/messages": ["libs/frontend/ui/pages/src/index.ts"],
      "@fe/post": ["libs/frontend/post/src/index.ts"],
      "@fe/shared": ["libs/frontend/shared/src/index.ts"],
      "@fe/simpledialog": ["libs/frontend/ui/simpledialog/src/index.ts"],
      "@fe/task": ["libs/frontend/task/src/index.ts"],
      "@fe/theme-selector": [
        "libs/frontend/ui/theming/theme-selector/src/index.ts"
      ],
      "@fe/todo": ["libs/frontend/todo/src/index.ts"],
      "@fe/translate": ["libs/frontend/ui/translate/src/index.ts"],
      "@fe/ui/pages": ["libs/frontend/ui/pages/src/index.ts"],
      "@fe/user": ["libs/frontend/user/src/index.ts"],
      "@fe/utilities": ["libs/frontend/utilities/src/index.ts"],
      "@prisma/prisma": ["libs/prisma/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
